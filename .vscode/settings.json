{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv-pipeline/Scripts/python.exe",
  "python.analysis.extraPaths": ["data-pipeline"],
  "python.analysis.exclude": ["**/.venv*/**", "**/node_modules/**", "**/frontend/dist/**", "**/data/derived/**"],
  "files.watcherExclude": {
    "**/.venv*/**": true,
    "**/node_modules/**": true,
    "**/frontend/dist/**": true,
    "**/frontend/public/data/**": true,
    "**/__pycache__/**": true,
    "**/data/raw/**": true,
    "**/data/derived/**": true
  },
  "search.exclude": {"**/.venv*": true, "**/node_modules": true, "**/frontend/dist": true, "**/data/derived": true}
}
